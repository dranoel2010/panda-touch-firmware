# Hardware Panda Touch (aus dem BSP-Beispiel display_hello)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# LVGL über Kconfig, kein lv_conf.h
CONFIG_LV_CONF_SKIP=y
# Eigene Partitionstabelle: 8 MB App (Schriften + Schattenmasken der Soft-White-Oberfläche)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Soft White: Verläufe in beliebigem Winkel (CSS linear-gradient), Speicher aus dem großen PSRAM
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_FLOAT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Debug-Kanal: Bildschirm-Schnappschuss über USB (tools/sim/device_snap.py)
CONFIG_LV_USE_SNAPSHOT=y
