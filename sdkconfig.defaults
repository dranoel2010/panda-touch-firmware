# Hardware Panda Touch (aus dem BSP-Beispiel display_hello)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Befehls-Cache 32 statt 16 KB: der Zeichencode ist groß und läuft aus dem Flash
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# LVGL über Kconfig, kein lv_conf.h
CONFIG_LV_CONF_SKIP=y
# Eigene Partitionstabelle: 8 MB App (Schriften + Schattenmasken der Soft-White-Oberfläche)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Soft White: Verläufe in beliebigem Winkel (CSS linear-gradient), Speicher aus dem großen PSRAM
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_FLOAT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Debug-Kanal: Bildschirm-Schnappschuss über USB (tools/sim/device_snap.py)
CONFIG_LV_USE_SNAPSHOT=y
# Leistung: optimiert übersetzen (Standard wäre -Og)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# eine Zeichen-Einheit (zwei belasten den PSRAM so, dass das Display verrutscht), und die zeichnet direkt
# im Oberflächen-Task: ein eigener Zeichen-Thread kostete je Zeichenauftrag zwei Taskwechsel
CONFIG_LV_OS_NONE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Display stabil (kein Verrutschen bei viel Zeichenarbeit): größerer Zwischenpuffer.
# Kein erzwungener Neustart der Übertragung in jedem Bild: mit Zwischenpuffer richtet der Treiber
# nur bei wirklich verpasstem Nachschub neu aus; der Dauer-Neustart ließ Bilder um 20 Zeilen springen,
# wenn der Nachschub am Bildende knapp kam
CONFIG_BSP_LCD_RGB_BOUNCE_BUF_HEIGHT=20
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n
# Drucker-Anbindung: Der P1S hat ein selbst signiertes Zertifikat (nur lokales Netz)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# TLS- und WLAN-Puffer in den PSRAM, der interne RAM ist mit den Display-Streifen knapp
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# WLAN schlank: der interne (DMA-fähige) RAM ist durch die Display-Streifen fast voll
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# internen RAM für WLAN/MQTT (Task-Stacks, Treiber) freihalten; kleine LVGL-Objekte weichen in den PSRAM aus
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# WLAN-/LWIP-Code nicht in den internen RAM legen (kostet sonst zig KB; für ein Bedienteil reicht die Geschwindigkeit)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
# MQTT-Task-Stack und -Puffer in den PSRAM (der Ereignis-Handler greift nicht auf Flash/NVS zu)
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_MQTT_TASK_STACK_ON_EXTERNAL_MEMORY=y
CONFIG_MQTT_BUFFERS_ON_EXTERNAL_MEMORY=y
# AES in Software: die Hardware-AES braucht internen DMA-Speicher, der für große Druckerberichte fehlt
CONFIG_MBEDTLS_HARDWARE_AES=n
# MQTT auf Kern 0 (die Oberfläche läuft auf Kern 1)
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
